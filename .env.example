# ==============================================================================
# CONFIGURACIÓN DE APIS Y ENDPOINTS - PLANTILLA (.env.example)
# ==============================================================================

# Exploradores de bloques
ETHERSCAN_API_KEY=""
ARBISCAN_API_KEY=""
POLYGONSCAN_API_KEY=""
BSCSCAN_API_KEY=""

# Endpoints RPC Web3
ETH_RPC_URL="https://cloudflare-eth.com"
ARB_RPC_URL="https://arb1.arbitrum.io/rpc"
POLYGON_RPC_URL="https://polygon-rpc.com"
BSC_RPC_URL="https://bsc-dataseed.binance.org"

# APIs de Mercado
COINGECKO_API_KEY=""
DEFILLAMA_API_KEY=""

# Inteligencia de Seguridad (CertiK Skynet Partner API)
# Requiere credenciales de partner comercial con CertiK (APIsupport@certik.com)
CERTIK_API_KEY=""
CERTIK_BASE_URL="https://partner.certik-skynet.com"
CERTIK_TIMEOUT_SECONDS="10"

